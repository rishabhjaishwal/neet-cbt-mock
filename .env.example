# MongoDB Atlas (X509)
MONGODB_URI=mongodb+srv://<cluster>.mongodb.net/?authSource=%24external&authMechanism=MONGODB-X509&compressors=zlib
MONGODB_DB=neet_cbt
# Prefer file path locally (never commit the PEM):
MONGODB_X509_CERT=/absolute/path/to/client.pem
# Or paste full PEM (cert+key) for hosted deploys / secrets managers:
# MONGODB_X509_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----BEGIN PRIVATE KEY-----\n..."
AUTH_SECRET=replace-with-long-random-string
